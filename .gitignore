# 运行时数据（首次启动自动创建，不入库）
#
# ⚠️ 这里的规则必须覆盖"用户会往里面塞东西"的所有目录。
#    历史上 data/prompts/ 和 data/runs/ 被漏掉了，结果别人的提示词和
#    job 历史被提交进仓库 —— 克隆下来会看到一堆不属于自己的产物。
data/config.json
data/*.json
data/outputs/
data/previz/
data/post/
data/assets/
data/shots/
data/runs/
data/extras/
data/previz-shots/
data/inputs/
data/vault/
data/prompts/
data/projects/
# 剪辑工程与剪辑产物 —— 同属运行时数据，不入库
# （工程 json 里只有片段相对路径与音轨设置，但产出 mp4 会撑爆仓库）
data/edit/

# 仓库里只保留工作流模板
!data/workflows/

# 前端依赖与构建中间产物
#
# 注意：app-dist/ **不**忽略 —— 它是随插件分发的构建产物，
# 用户从 GitHub 拿到后不需要装 node 就能直接用。
# 只忽略构建中间产物和依赖。
app-src/node_modules/
app-src/dist/

# 系统与编辑器
.DS_Store
Thumbs.db
*.log
*.tmp

# 本地备份
*.broken
*.stage3-backup/
*.stage3bak
*.stage4bak
*.reinstall-backup-*
__pycache__/

# 生成的成片与抽帧 —— **不入库**
#
# 为什么：这些是运行产物，不是源码。
#   · 每轮实验都会产出几十 MB，累积起来仓库会被撑爆
#   · 二进制文件在 git 里无法增量存储，历史只增不减
#   · 想看效果应当自己跑一次，或看 Release 附件
#
# 保留的是「分析文档」：docs/VIDEO-ANALYSIS.md、docs/prompts.json
# —— 那是可审阅的文本，不是视频。
docs/result/
docs/probes/

# 任何位置的大媒体文件
*.mp4
*.mov
*.webm
*.mkv
*.avi

# 本地盘点文档 —— 不入库
#
# docs/LORA-NSFW-CATALOG.md 是本地 LoRA 资源索引，含成人向资源清单。
# 公开仓库不应包含这类索引：与项目本身（视频制作工具）无关，
# 且可能触碰托管平台的内容政策。文档仍保留在本地供参考。
docs/LORA-NSFW-CATALOG.md
docs/LORA-DR34ML4Y.md

# 换人实验产物 —— 与其它运行时数据同属不入库
#
# ⚠️ 历史缺陷：上面的 data/*.json 只覆盖一层，data/replace/ 下的
#    png / csv / json 全部漏网 → 77 个文件、41.88 MB 被提交进仓库，
#    且运行时还在持续写入（git status 永远是脏的）。
data/replace/
data/shots/
data/projects/
data/vault/
data/runs/
data/previz/
data/post/
data/edit/
data/inputs/
data/tmp-inline/

# json-store 的原子写备份与损坏副本 —— 运行时产物，不入库
data/*.bak
data/**/*.bak
data/*.corrupt
data/**/*.corrupt

# ============================================================================
# data/ 的兜底规则：**除模板外全部忽略**
# ============================================================================
#
# 为什么要有这条兜底 —— 上面那一长串逐目录列举**反复漏项**：
#
#   · 历史缺陷 1：data/prompts/ 与 data/runs/ 漏掉 → 别人的提示词和 job 历史被提交
#   · 历史缺陷 2：data/*.json 只覆盖一层 → data/replace/ 下 77 个文件、41.88 MB 入库
#   · 本次实测又发现 3 个漏项：data/inbox/、data/proj_qm/、data/proj_refs/
#     （都是用户自己的素材/中间产物，`git status` 一直是脏的）
#
# 逐条列举的**根本问题**是：只有在有人手工往 data/ 里放东西之后，
# 才会发现漏了哪个目录；而那时文件已经被 add 进去了。
#
# 所以改成白名单为主、黑名单兜底：
#   · data/ 下**只保留** workflows/ 模板（随插件分发的静态资源）
#   · 其余一律忽略（含将来新增的任何目录）
#
# ⚠️ 模板必须显式用 `!` 放行，否则会被 `data/*` 一起忽略掉。
data/*
!data/workflows/
