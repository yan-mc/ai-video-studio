# 运行时数据（首次启动自动创建，不入库）
#
# ⚠️ 这里的规则必须覆盖"用户会往里面塞东西"的所有目录。
#    历史上 data/prompts/ 和 data/runs/ 被漏掉了，结果别人的提示词和
#    job 历史被提交进仓库 —— 克隆下来会看到一堆不属于自己的产物。
data/config.json
data/*.json
data/outputs/
data/previz/
data/post/
data/assets/
data/shots/
data/runs/
data/extras/
data/previz-shots/
data/inputs/
data/vault/
data/prompts/
data/projects/

# 仓库里只保留工作流模板
!data/workflows/

# 前端依赖与构建中间产物
#
# 注意：app-dist/ **不**忽略 —— 它是随插件分发的构建产物，
# 用户从 GitHub 拿到后不需要装 node 就能直接用。
# 只忽略构建中间产物和依赖。
app-src/node_modules/
app-src/dist/

# 系统与编辑器
.DS_Store
Thumbs.db
*.log
*.tmp

# 本地备份
*.broken
*.stage3-backup/
*.stage3bak
*.stage4bak
*.reinstall-backup-*
__pycache__/
