{
  "name": "@local/dsh-jiuzhang-studio",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "九章工作室 — DSH 本地 AI 视频工作室：智能分镜 / 渲染 V2（南风 V15，217 参数）/ 跨镜头续写 / 角色卡 / 素材库 / 3D 预演 / H3 与 H3-Image 双后端",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "vendor/**/*.py",
    "vendor/**/*.json",
    "vendor/**/*.md",
    "vendor/**/*.txt",
    "vendor/**/*.ps1",
    "host/**/*.js",
    "host/blender/**/*.py",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "app-dist/**",
    "skills/**",
    "data/workflows/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "vite build --config app-src/vite.config.ts",
    "test": "node tools/smoke-api.mjs",
    "typecheck": "tsc -p app-src/tsconfig.json --noEmit",
    "check:routes": "node tools/check-routes.mjs",
    "preview": "node tools/preview-server.mjs",
    "audit:params": "node tools/audit-params.mjs"
  }
}
