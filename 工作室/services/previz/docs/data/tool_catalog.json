{
 "director_get_state": {
  "description": "Read the complete Director project, evaluated current frame, exact IDs, templates, locks and health issues. Call this before editing.",
  "params": {}
 },
 "director_create_project": {
  "description": "Create a clean local previs project with two actors, four shots and a 15-second timeline.",
  "params": {
   "name": {
    "type": "string",
    "optional": true,
    "description": "Project title"
   }
  }
 },
 "director_select": {
  "description": "Select a shot or seek to an exact integer frame at 24fps.",
  "params": {
   "shot_id": {
    "type": "string",
    "optional": true
   },
   "frame": {
    "type": "number",
    "min": 0,
    "integer": true,
    "optional": true
   }
  }
 },
 "director_add_element": {
  "description": "Add a stable-ID actor, animal, crowd or greybox prop to every shot. Prefer preset IDs from director_get_state.",
  "params": {
   "kind": {
    "type": "string",
    "enum": [
     "mannequin",
     "crowd",
     "box",
     "sphere",
     "cylinder",
     "wall"
    ],
    "optional": true
   },
   "preset": {
    "type": "string",
    "enum": [
     "person",
     "tall-person",
     "child",
     "quadruped",
     "small-animal",
     "crowd-3",
     "crowd-5",
     "table",
     "round-table",
     "chair",
     "sofa",
     "door",
     "wall",
     "column",
     "car",
     "screen",
     "crate"
    ],
    "optional": true
   },
   "name": {
    "type": "string",
    "optional": true
   },
   "position": {
    "type": "object",
    "optional": true
   },
   "rotation_deg": {
    "type": "object",
    "optional": true
   },
   "scale": {
    "type": "object",
    "optional": true
   },
   "color": {
    "type": "string",
    "optional": true
   },
   "identity_source": {
    "type": "string",
    "enum": [
     "workshop",
     "temporary",
     "image-analysis"
    ],
    "optional": true
   },
   "character_id": {
    "type": "string",
    "optional": true
   },
   "performance_profile_id": {
    "type": "string",
    "enum": [
     "neutral",
     "restrained",
     "confident",
     "energetic",
     "nervous",
     "tired",
     "authoritative",
     "casual"
    ],
    "optional": true
   }
  }
 },
 "director_update_element": {
  "description": "Move, rotate, scale, rename or recolour a stage element. Use shot_only for blocking that only applies to one shot.",
  "params": {
   "element_id": {
    "type": "string",
    "optional": false
   },
   "shot_id": {
    "type": "string",
    "optional": true
   },
   "shot_only": {
    "type": "boolean",
    "optional": true
   },
   "name": {
    "type": "string",
    "optional": true
   },
   "position": {
    "type": "object",
    "optional": true
   },
   "rotation_deg": {
    "type": "object",
    "optional": true
   },
   "target_element_id": {
    "type": "string",
    "optional": true
   },
   "facing": {
    "type": "string",
    "enum": [
     "toward-target",
     "away-from-target",
     "face-each-other",
     "same-as-target",
     "keep"
    ],
    "optional": true
   },
   "scale": {
    "type": "object",
    "optional": true
   },
   "color": {
    "type": "string",
    "optional": true
   },
   "visible": {
    "type": "boolean",
    "optional": true
   },
   "height_m": {
    "type": "number",
    "min": 0.2,
    "max": 4,
    "optional": true
   },
   "pose_id": {
    "type": "string",
    "optional": true
   },
   "performance_profile_id": {
    "type": "string",
    "enum": [
     "neutral",
     "restrained",
     "confident",
     "energetic",
     "nervous",
     "tired",
     "authoritative",
     "casual"
    ],
    "optional": true
   }
  }
 },
 "director_apply_action": {
  "description": "Apply a professional motion template to an exact actor ID and generate editable motion keyframes.",
  "params": {
   "element_id": {
    "type": "string",
    "optional": false
   },
   "shot_id": {
    "type": "string",
    "optional": true
   },
   "action": {
    "type": "string",
    "optional": false,
    "description": "Action template ID from director_get_state"
   },
   "start_frame": {
    "type": "number",
    "min": 0,
    "integer": true,
    "optional": true
   },
   "duration_frames": {
    "type": "number",
    "integer": true,
    "positive": true,
    "optional": true
   },
   "from": {
    "type": "object",
    "optional": true
   },
   "to": {
    "type": "object",
    "optional": true
   },
   "target_element_id": {
    "type": "string",
    "optional": true
   },
   "facing": {
    "type": "string",
    "enum": [
     "toward-target",
     "away-from-target",
     "face-each-other",
     "same-as-target",
     "keep"
    ],
    "optional": true
   },
   "proximity_m": {
    "type": "number",
    "min": 0,
    "max": 10,
    "optional": true
   },
   "emotion": {
    "type": "string",
    "enum": [
     "neutral",
     "tender",
     "intimate",
     "tense",
     "joyful",
     "grief",
     "menacing"
    ],
    "optional": true
   },
   "intensity": {
    "type": "number",
    "min": 0.1,
    "max": 3,
    "optional": true
   },
   "locked": {
    "type": "boolean",
    "optional": true
   },
   "source": {
    "type": "string",
    "enum": [
     "agent",
     "manual"
    ],
    "optional": true
   }
  }
 },
 "director_set_motion_keyframe": {
  "description": "Add or edit an actor motion keyframe, including Bezier path handles, rotation and joints. Locked work requires explicit override.",
  "params": {
   "shot_id": {
    "type": "string",
    "optional": true
   },
   "action_id": {
    "type": "string",
    "optional": false
   },
   "keyframe_id": {
    "type": "string",
    "optional": true
   },
   "frame": {
    "type": "number",
    "min": 0,
    "integer": true,
    "optional": false
   },
   "position": {
    "type": "object",
    "optional": true
   },
   "rotation_deg": {
    "type": "object",
    "optional": true
   },
   "path_in": {
    "type": "object",
    "optional": true
   },
   "path_out": {
    "type": "object",
    "optional": true
   },
   "path_mode": {
    "type": "string",
    "enum": [
     "corner",
     "smooth"
    ],
    "optional": true
   },
   "joints": {
    "type": "object",
    "optional": true
   },
   "interpolation": {
    "type": "string",
    "enum": [
     "hold",
     "linear",
     "smooth",
     "ease-in",
     "ease-out"
    ],
    "optional": true
   },
   "note": {
    "type": "string",
    "optional": true
   },
   "locked": {
    "type": "boolean",
    "optional": true
   },
   "source": {
    "type": "string",
    "enum": [
     "agent",
     "manual"
    ],
    "optional": true
   },
   "override_locked": {
    "type": "boolean",
    "optional": true
   }
  }
 },
 "director_apply_camera": {
  "description": "Apply a professional camera move template and generate editable camera keyframes.",
  "params": {
   "shot_id": {
    "type": "string",
    "optional": true
   },
   "move": {
    "type": "string",
    "optional": false,
    "description": "Camera template ID from director_get_state"
   },
   "override_locked": {
    "type": "boolean",
    "optional": true
   }
  }
 },
 "director_set_camera_keyframe": {
  "description": "Add or edit a camera keyframe with exact frame, position, target, field of view and roll.",
  "params": {
   "shot_id": {
    "type": "string",
    "optional": true
   },
   "keyframe_id": {
    "type": "string",
    "optional": true
   },
   "frame": {
    "type": "number",
    "min": 0,
    "integer": true,
    "optional": false
   },
   "position": {
    "type": "object",
    "optional": true
   },
   "target": {
    "type": "object",
    "optional": true
   },
   "fov": {
    "type": "number",
    "min": 5,
    "max": 140,
    "optional": true
   },
   "roll_deg": {
    "type": "number",
    "min": -180,
    "max": 180,
    "optional": true
   },
   "interpolation": {
    "type": "string",
    "enum": [
     "hold",
     "linear",
     "smooth",
     "ease-in",
     "ease-out"
    ],
    "optional": true
   },
   "note": {
    "type": "string",
    "optional": true
   },
   "locked": {
    "type": "boolean",
    "optional": true
   },
   "source": {
    "type": "string",
    "enum": [
     "agent",
     "manual"
    ],
    "optional": true
   },
   "override_locked": {
    "type": "boolean",
    "optional": true
   }
  }
 },
 "director_manage_shot": {
  "description": "Add, duplicate, rename, reorder or delete a shot. Shot times are normalized automatically.",
  "params": {
   "operation": {
    "type": "string",
    "enum": [
     "add",
     "duplicate",
     "rename",
     "reorder",
     "delete"
    ],
    "optional": false
   },
   "shot_id": {
    "type": "string",
    "optional": true
   },
   "name": {
    "type": "string",
    "optional": true
   },
   "duration_frames": {
    "type": "number",
    "integer": true,
    "positive": true,
    "optional": true
   },
   "index": {
    "type": "number",
    "min": 0,
    "integer": true,
    "optional": true
   }
  }
 },
 "director_set_lock": {
  "description": "Lock or unlock a manually approved action or keyframe. Agents must preserve locked work.",
  "params": {
   "target": {
    "type": "string",
    "enum": [
     "action",
     "motion_keyframe",
     "camera_keyframe"
    ],
    "optional": false
   },
   "id": {
    "type": "string",
    "optional": false
   },
   "shot_id": {
    "type": "string",
    "optional": true
   },
   "locked": {
    "type": "boolean",
    "optional": true
   }
  }
 },
 "director_delete": {
  "description": "Delete an element, action or keyframe. Locked work requires explicit override.",
  "params": {
   "target": {
    "type": "string",
    "enum": [
     "element",
     "action",
     "motion_keyframe",
     "camera_keyframe"
    ],
    "optional": false
   },
   "id": {
    "type": "string",
    "optional": false
   },
   "shot_id": {
    "type": "string",
    "optional": true
   },
   "override_locked": {
    "type": "boolean",
    "optional": true
   }
  }
 },
 "director_undo": {
  "description": "Undo exactly one Director edit. History stores up to 50 complete project snapshots.",
  "params": {}
 },
 "director_redo": {
  "description": "Redo exactly one previously undone Director edit.",
  "params": {}
 },
 "director_validate": {
  "description": "Inspect the project for collisions, overlaps, discontinuities, missing paths, invalid ranges and camera problems.",
  "params": {}
 }
}