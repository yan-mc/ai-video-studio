{
  "name": "@local/dsh-jiuzhang-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "九章工作室 — DSH 本地 AI 视频工作室：节点画布 / 素材库 / 剧本漫画分镜 / 六导演台 / H3 与 Seedance 双后端",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "app-dist/**",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node ../app-src/node_modules/vite/bin/vite.js build"
  }
}