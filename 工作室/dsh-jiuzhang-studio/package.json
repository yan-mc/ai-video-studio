    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "vite build --config app-src/vite.config.ts",
    "test": "node tests/verify-all.mjs",
    "typecheck": "tsc -p app-src/tsconfig.json --noEmit"
