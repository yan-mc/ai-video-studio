{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "H3 主模型（按 ref2v/fl2v 切换）"
    },
    "inputs": {
      "unet_name": "{{UNET_NAME}}",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "文本编码器 Qwen3-VL-32B INT8"
    },
    "inputs": {
      "clip_name": "{{CLIP_NAME}}",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "视频 VAE fp16"
    },
    "inputs": {
      "vae_name": "{{VAE_NAME}}"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "音频 VAE fp32（必须）"
    },
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "5": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Turbo LoRA（4步）"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "lora_name": "{{LORA_NAME}}",
      "strength_model": "{{LORA_STRENGTH}}"
    }
  },
  "6": {
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": {
      "title": "H3 生成（首尾帧+提示词）"
    },
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "prompt": "{{PROMPT}}",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{LENGTH}}"
    }
  },
  "7": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "8": {
    "class_type": "BasicScheduler",
    "_meta": {
      "title": "调度（steps 由档位驱动）"
    },
    "inputs": {
      "model": [
        "5",
        0
      ],
      "scheduler": "simple",
      "steps": "{{STEPS}}",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{SEED}}"
    }
  },
  "10": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "5",
        0
      ],
      "conditioning": [
        "6",
        0
      ]
    }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "9",
        0
      ],
      "guider": [
        "10",
        0
      ],
      "sampler": [
        "7",
        0
      ],
      "sigmas": [
        "8",
        0
      ],
      "latent_image": [
        "6",
        1
      ]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "fps": "{{FPS}}",
      "audio": [
        "15",
        0
      ]
    }
  },
  "14": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "13",
        0
      ],
      "filename_prefix": "h3/dsh_video",
      "format": "mp4"
    }
  },
  "20": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "首帧（来自预演 first.png）"
    },
    "inputs": {
      "image": "{{FIRST_FRAME}}",
      "upload": "image"
    }
  },
  "21": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "尾帧（来自预演 last.png）"
    },
    "inputs": {
      "image": "{{LAST_FRAME}}",
      "upload": "image"
    }
  },
  "15": {
    "class_type": "VAEDecodeAudio",
    "_meta": {
      "title": "音频解码（H3 原生音频，必须用 fp32 音频 VAE）"
    },
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "4",
        0
      ]
    }
  }
}