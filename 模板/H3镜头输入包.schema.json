{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "H3 镜头输入包（Shot Input Package）",
  "description": "用于把分镜/角色/预演素材编译成可复现的 H3 生成任务。字段与《AI视频制作软件与H3本地部署深度指南》附录 A 对应。",
  "type": "object",
  "required": ["shot_id", "mode", "duration_s", "canvas", "engine", "prompt_file"],
  "properties": {
    "shot_id": {"type": "string", "description": "项目-场-镜编号，如 EP01-SC03-SH012"},
    "mode": {
      "type": "string",
      "enum": ["t2va", "i2va", "l2va", "fl2va", "ref2va"],
      "description": "任务模式；ref2va 与 keyframes 互斥"
    },
    "duration_s": {"type": "integer", "minimum": 4, "maximum": 15, "description": "整数秒；后端会吸附到 17k+5 帧网格"},
    "ratio": {"type": "string", "enum": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16", "adaptive"]},
    "canvas": {
      "type": "array",
      "items": {"type": "integer", "multipleOf": 32},
      "minItems": 2,
      "maxItems": 2,
      "description": "[width, height]，短边 768，面积不超过 768×1344；推荐 [1344, 768]"
    },
    "style": {"type": "string", "description": "全局风格/光线/色调描述，编译进提示词首段"},
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "description": "如 S1"},
          "name": {"type": "string"},
          "refs": {"type": "array", "items": {"type": "string"}, "description": "独立高清参考图路径（不要 3×3 网格）"},
          "retention": {"type": "string", "enum": ["fully_preserved", "partially_preserved", "attribute_transfer", "weak_reference"]},
          "voice_ref": {"type": "string", "description": "音色参考音频（2—15 秒）"}
        }
      }
    },
    "references": {
      "type": "object",
      "properties": {
        "images": {"type": "array", "items": {"type": "string"}, "maxItems": 9},
        "videos": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
        "audios": {"type": "array", "items": {"type": "string"}, "maxItems": 3}
      },
      "description": "合计文件数 ≤12；每段视频/音频 2—15 秒、各自总时长 ≤15 秒"
    },
    "keyframes": {
      "type": "object",
      "properties": {
        "first": {"type": ["string", "null"]},
        "last": {"type": ["string", "null"]}
      },
      "description": "i2va/l2va/fl2va 使用；官方 API 最多 2 张；与 references 互斥"
    },
    "previz": {
      "type": "object",
      "properties": {
        "blender_scene": {"type": "string"},
        "camera": {"type": "string", "description": "camera.json：机位/焦距/关键帧，仅软件记录用"},
        "first_frame": {"type": "string"},
        "last_frame": {"type": "string"},
        "control": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["canny", "depth", "hed", "mlsd", "pose", "scribble", "layout", "gray"]},
            "file": {"type": "string", "description": "控制视频（24fps，≤15s）"},
            "strength": {"type": "number", "default": 1.0}
          },
          "description": "仅本地 ComfyUI + Fun ControlNet Union 路线；官方 API 不支持"
        }
      }
    },
    "prompt_sections": {
      "type": "object",
      "description": "结构化提示词各段（t2va/fl2va 为三段式；ref2va 为六段式）",
      "properties": {
        "subject_definitions": {"type": "string"},
        "summary": {"type": "string"},
        "retention_analysis": {"type": "string"},
        "integrated_multimodal_description": {"type": "string"},
        "detailed_description": {"type": "string"},
        "overall_soundscape": {"type": "string"},
        "non_diegetic_music": {"type": "string"}
      }
    },
    "prompt_file": {"type": "string", "description": "最终送入模型的提示词文件路径；2K 再生成必须原样回放"},
    "engine": {
      "type": "object",
      "required": ["backend", "model"],
      "properties": {
        "backend": {"type": "string", "enum": ["local_comfyui", "local_sglang", "local_diffsynth", "api_minimax", "external_api"]},
        "model": {"type": "string"},
        "mode": {"type": "string", "enum": ["t2va", "i2va", "l2va", "fl2va", "ref2va"]},
        "steps": {"type": "integer", "description": "FL2VA 20 或 8 Turbo；Ref2VA 20 或 4 Turbo"},
        "sampler": {"type": "string", "default": "res_multistep"},
        "scheduler": {"type": "string", "default": "simple"},
        "shift_video": {"type": "number", "default": 12.0, "description": "Turbo 768p 用 6"},
        "shift_audio": {"type": "number", "default": 3.0},
        "seed": {"type": "integer"},
        "ref_image_size": {"type": "string", "enum": ["match", "max"]}
      }
    },
    "speakers": {"type": "object", "description": "说话人 ID → 角色 ID，如 {\"S1\": \"charA\"}"},
    "delivery": {
      "type": "object",
      "properties": {
        "target": {"type": "string", "enum": ["768p", "1080p", "2K"]},
        "upscale": {"type": "string", "description": "SeedVR2/FlashVSR/视频增强软件；2K 官方再生成则写 minimax_regenerate_2k"},
        "ai_label": {"type": "boolean", "default": true}
      }
    },
    "qc": {
      "type": "object",
      "properties": {
        "checks": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["pending", "passed", "rework", "rejected"]},
        "notes": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "ref2va"}}},
      "then": {"required": ["references"],
               "not": {"required": ["keyframes"]},
               "properties": {"keyframes": {"type": "null"}}}
    },
    {
      "if": {"properties": {"mode": {"enum": ["i2va", "l2va", "fl2va"]}}},
      "then": {"required": ["keyframes"],
               "not": {"required": ["references"]}}
    },
    {
      "if": {"properties": {"engine": {"properties": {"backend": {"enum": ["api_minimax", "external_api"]}}}}},
      "then": {"properties": {"previz": {"properties": {"control": {"type": "null"}}}}}
    }
  ]
}
